// ============================================================
// HOMEPULSE — COMPLETE DATABASE SCHEMA
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
  GUARANTOR
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
  INACTIVE
  DEACTIVATED
}

enum FurnishedLevel {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum FloorType {
  GROUND
  BASEMENT
  MIDDLE
  TOP
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  BEDSITTER
  MAISONETTE
  TOWNHOUSE
  VILLA
  COMMERCIAL
  LAND
  NYUMBA_YA_MABATI
  SINGLE_ROOM
  SELF_CONTAINED
  GUEST_HOUSE
  HOSTEL_ROOM
  OFFICE
  SHOP
  WAREHOUSE
  FACTORY
  AGRICULTURAL
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  DELETED
  DRAFT
  PUBLISHED
  EXPIRED
  ACTIVE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  REVERSED
  TIMEOUT
}

enum PaymentMethod {
  MPESA
  STRIPE
  BANK_TRANSFER
  CASH
  QR_CODE
  CARD
  ESCROW
}

enum EscrowStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  REJECTED
  APPEALED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DisputeType {
  PAYMENT
  PROPERTY
  LANDLORD
  TENANT
  MAINTENANCE
  OTHER
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

enum NotificationType {
  GENERAL
  PAYMENT
  PROPERTY
  MESSAGE
  DISPUTE
  PROMOTIONAL
  SYSTEM
  SAFETY
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  DOCUMENT
  NEGOTIATION
  QR_CODE
  LOCATION
}

enum SOSStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
  CANCELLED
}

enum SOSAlertType {
  PANIC
  MEDICAL
  FIRE
  CRIME
  OTHER
}

enum SafetyReportStatus {
  OPEN
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

enum SafetyReportType {
  CRIME
  HARASSMENT
  SCAM
  UNSAFE_CONDITIONS
  NOISE
  OTHER
}

enum CommunityRole {
  MEMBER
  MODERATOR
  ADMIN
  CREATOR
}

enum CommunityPostType {
  TEXT
  IMAGE
  VIDEO
  POLL
  EVENT
  ANNOUNCEMENT
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  EMERGENCY
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  NEEDS_PARTS
  WAITING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  NEEDS_REVIEW
  VERIFIED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  PAID
  VOID
  EXPIRED
  REDEEMED
}

enum ReferralRewardType {
  CREDITS
  DISCOUNT
  CASH
  VIP
}

enum BannerStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  ENDED
  EXPIRED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  ENDED
  COMPLETED
  CANCELLED
}

enum QRStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
  USED
  EXHAUSTED
}

enum IdentityType {
  NATIONAL_ID
  PASSPORT
  DRIVING_LICENSE
  BIRTH_CERTIFICATE
  OTHER
}

// ============================================================
// MODELS
// ============================================================

// ---------- USERS ----------
model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  phone               String     @unique
  firstName           String
  lastName            String
  password            String?
  role                UserRole   @default(TENANT)
  status              UserStatus @default(ACTIVE)
  isVerified          Boolean    @default(false)
  isActive            Boolean    @default(true)
  isOnline            Boolean    @default(false)
  lastSeen            DateTime?
  responseTimeMinutes Int?
  totalProperties     Int        @default(0)
  rating              Float?
  city                String?
  profileImage        String?
  bio                 String? @db.Text
  instagram           String?
  twitter              String?
  facebook             String?
  linkedin             String?
  tiktok               String?
  youtube              String?
  website              String?
  showEmail           Boolean @default(false)
  showPhone           Boolean @default(true)
  showLocation        Boolean @default(true)
  showOnlineStatus    Boolean @default(true)
  showLastSeen        Boolean @default(true)

  // Social comments
  propertyComments     PropertyComment[] @relation("CommentUser")
  commentLikes         CommentLike[]

  // Social interactions
  propertyLikes        PropertyLike[]
  followers            UserFollow[]     @relation("Followers")
  following            UserFollow[]     @relation("Following")
  blockedUsers         UserBlock[]      @relation("Blocking")
  blockingUsers        UserBlock[]      @relation("Blocked")

  // Relationships
  resetToken          String?
  deletedAt           DateTime?

  // Relationships
  properties            Property[]             @relation("LandlordProperties")
  payments              Payment[]
  maintenanceRequests   MaintenanceRequest[]   @relation("RequestedBy")
  assignedMaintenance   MaintenanceRequest[]   @relation("AssignedTo")
  reviews               Review[]               @relation("ReviewAuthor")
  notifications         Notification[]
  chatMessages          ChatMessage[]          @relation("ChatSender")
  receivedMessages      ChatMessage[]          @relation("ChatReceiver")
  sosAlerts             SOSAlert[]
  safetyReports         SafetyReport[]
  roommateProfile       RoommateProfile?       @relation("RoommateUser")
  referralsMade         Referral[]             @relation("Referrer")
  referralsReceived     Referral[]             @relation("Referee")
  escrowTransactions    EscrowTransaction[]    @relation("EscrowPayer")
  escrowReceived        EscrowTransaction[]    @relation("EscrowPayee")
  settings              Setting?               @relation("UserSettings")
  communityMembers      Community[]            @relation("CommunityMembers")
  createdCommunities    Community[]            @relation("CommunityCreator")
  communityPosts        CommunityPost[]
  communityEvents       CommunityEvent[]       @relation("EventOrganizer")
  identityVerifications IdentityVerification[]
  qrCodes               QRCode[]
  bannerViews           BannerView[]
  savedSearches         SavedSearch[]
  bannersCreated        Banner[]               @relation("BannerCreator")
  disputes              Dispute[]              @relation("DisputeRaisedBy")
  disputeAssignments    Dispute[]              @relation("DisputeAssignedTo")
   tenantLeases          Lease[]                 @relation("TenantLeases")
   landlordLeases        Lease[]                 @relation("LandlordLeases")
   pageVisits            PageVisit[]
   subscriptions         Subscription[]
   subscriptionEvents    SubscriptionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   @@index([email])
   @@index([phone])
   @@index([role])
   @@index([status])
   @@index([city])
   @@index([deletedAt])
   @@map("users")

   profileVideo UserProfileVideo?
   profileMusic UserProfileMusic?
   privacySettings PrivacySettings?
   profileCard UserProfileCard?
   locationFuzzPreference LocationFuzzPreference?
   offlineCaches OfflineCache[]
   dataExportRequests DataExportRequest[]
   dataDeleteRequests DataDeleteRequest[]
   appIconStates AppIconState[]
   updatedThemes SystemTheme[]
 }

// ---------- PROPERTIES ----------
model Property {
  id                  String            @id @default(uuid())
  title               String
  description         String?
  type                PropertyType      @default(APARTMENT)
  status              PropertyStatus    @default(PENDING)
  price               Float
  currency            String            @default("KES")
  city                String
  neighborhood        String?
  address             String?
  bedrooms            Int?
  bathrooms           Int?
  area                 Float?
  squareMeters        Float?
  yearBuilt           Int?
  furnishedLevel      FurnishedLevel?
  floorNumber         String?
  totalFloors         Int?
  parkingSpaces       Int               @default(0)
  isPetFriendly       Boolean           @default(false)
  isWheelchairAccessible Boolean         @default(false)
  airConditioning     Boolean           @default(false)
  balcony             Boolean           @default(false)
  terrace             Boolean           @default(false)
  garden              Boolean           @default(false)
  pool                Boolean           @default(false)
  gym                 Boolean           @default(false)
  elevator            Boolean           @default(false)
  laundry             Boolean           @default(false)
  dishwasher          Boolean           @default(false)
  wifi                Boolean           @default(false)
  security            Boolean           @default(false)
  fencing             Boolean           @default(false)
  images              String[]
  amenities           String[]
  latitude            Float?
  longitude           Float?
  isFurnished         Boolean           @default(false)
  hasParking          Boolean           @default(false)
  hasSecurity         Boolean           @default(false)
  hasBackupPower      Boolean           @default(false)
  hasWaterTank        Boolean           @default(false)
  isStudentOnly       Boolean           @default(false)
  isFamilyFriendly    Boolean           @default(false)
  isVerified          Boolean           @default(false)
  views               Int               @default(0)
  likes               Int               @default(0)
  landlordId          String
  landlord            User              @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  approvedById        String?
  rejectionReason     String?
  deletedAt           DateTime?
  publishedAt         DateTime?

  // Relationships
  propertyImages      PropertyImage[]
  propertyVideos      PropertyVideo[]
  propertyViews        PropertyView[]
  qrCodes             QRCode[]
  reviews             Review[]             @relation("PropertyReviews")
  maintenanceRequests MaintenanceRequest[] @relation("PropertyRequests")
  escrowTransactions  EscrowTransaction[]  @relation("PropertyEscrows")
  savedSearches       SavedSearch[]
  banner              Banner?              @relation("PropertyBanner")
  disputes            Dispute[]            @relation("PropertyDisputes")
  leases              Lease[]
   propertyComments    PropertyComment[]
   propertyLikes        PropertyLike[]
   locationFuzz PropertyLocationFuzz?


   createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([status])
  @@index([landlordId])
  @@index([price])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("properties")
}

// ---------- PROPERTY IMAGES ----------
model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@map("property_images")
}

// ---------- PROPERTY VIDEOS ----------
model PropertyVideo {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url         String
  thumbnailUrl String?
  caption     String?
  createdAt   DateTime @default(now())

  @@index([propertyId])
  @@map("property_videos")
}

// ---------- PROPERTY VIEWS ----------
model PropertyView {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([createdAt])
  @@map("property_views")
}

// ---------- PAYMENTS ----------
model Payment {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Float
  currency      String        @default("KES")
  method        PaymentMethod @default(MPESA)
  status        PaymentStatus @default(PENDING)
  type          String        @db.VarChar(50) // rent, deposit, fee, refund
  transactionId String?       @unique
  reference     String?
  metadata      Json?
  escrowId      String?
  receiptUrl    String?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("payments")
}

// ---------- ESCROW ----------
model EscrowTransaction {
  id            String       @id @default(uuid())
  propertyId    String
  property      Property     @relation("PropertyEscrows", fields: [propertyId], references: [id])
  payerId       String
  payer         User         @relation("EscrowPayer", fields: [payerId], references: [id])
  payeeId       String
  payee         User         @relation("EscrowPayee", fields: [payeeId], references: [id])
  amount        Float
  currency      String       @default("KES")
  status        EscrowStatus @default(PENDING)
  releaseDate   DateTime?
  holdDays      Int          @default(14)
  transactionId String?      @unique
  releasedAt    DateTime?
  releasedById  String?
  disputeId     String?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@index([deletedAt])
  @@map("escrow_transactions")
}

// ---------- QR CODES ----------
model QRCode {
  id            String    @id @default(uuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  code          String    @unique
  secretKey     String
  expiresAt     DateTime
  scans         Int       @default(0)
  maxScans      Int       @default(100)
  status        QRStatus  @default(ACTIVE)
  lastScannedAt DateTime?

  createdAt DateTime @default(now())

  @@index([code])
  @@index([propertyId])
  @@index([status])
  @@map("qr_codes")
}

// ---------- BANNERS ----------
model Banner {
  id             String       @id @default(uuid())
  title          String
  description    String?
  imageUrl       String
  linkUrl        String?
  targetAudience String[]
  priority       Int          @default(0)
  status         BannerStatus @default(DRAFT)
  views          Int          @default(0)
  clicks         Int          @default(0)
  startDate      DateTime?
  endDate        DateTime?
  propertyId     String?      @unique
  property       Property?    @relation("PropertyBanner", fields: [propertyId], references: [id])
  createdById    String
  creator        User         @relation("BannerCreator", fields: [createdById], references: [id])
  deletedAt      DateTime?

  // Relationships
  bannerViews BannerView[] @relation("BannerViews")
  campaigns   Campaign[]   @relation("BannerCampaigns")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@map("banners")
}

// ---------- BANNER VIEWS ----------
model BannerView {
  id        String   @id @default(uuid())
  bannerId  String
  banner    Banner   @relation("BannerViews", fields: [bannerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  viewedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([bannerId])
  @@index([userId])
  @@map("banner_views")
}

// ---------- CAMPAIGNS ----------
model Campaign {
  id             String         @id @default(uuid())
  title          String
  description    String?
  bannerId       String
  banner         Banner         @relation("BannerCampaigns", fields: [bannerId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  budget         Float
  spent          Float          @default(0)
  status         CampaignStatus @default(DRAFT)
  conversions    Int            @default(0)
  targetAudience String[]
  goals          Json?
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bannerId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@map("campaigns")
}

// ---------- DISPUTES ----------
model Dispute {
  id           String          @id @default(uuid())
  type         DisputeType     @default(OTHER)
  status       DisputeStatus   @default(OPEN)
  priority     DisputePriority @default(MEDIUM)
  title        String
  description  String?
  evidence     String[]
  raisedById   String
  raisedBy     User            @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  assignedToId String?
  assignedTo   User?           @relation("DisputeAssignedTo", fields: [assignedToId], references: [id])
  resolution   String?
  resolvedAt   DateTime?
  propertyId   String?
  property     Property?       @relation("PropertyDisputes", fields: [propertyId], references: [id])
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([raisedById])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("disputes")
}

// ---------- NOTIFICATIONS ----------
model Notification {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  type        NotificationType    @default(GENERAL)
  title       String
  message     String
  channel     NotificationChannel @default(IN_APP)
  isRead      Boolean             @default(false)
  readAt      DateTime?
  data        Json?
  sentAt      DateTime?           @default(now())
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ---------- CHAT MESSAGES ----------
model ChatMessage {
  id             String          @id @default(uuid())
  conversationId String
  senderId       String
  sender         User            @relation("ChatSender", fields: [senderId], references: [id])
  receiverId     String
  receiver       User            @relation("ChatReceiver", fields: [receiverId], references: [id])
  content        String
  type           ChatMessageType @default(TEXT)
  mediaUrl       String?
  isRead         Boolean         @default(false)
  readAt         DateTime?
  deletedAt      DateTime?
  editedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("chat_messages")
}

// ---------- PROPERTY COMMENTS ----------
model PropertyComment {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("CommentUser", fields: [userId], references: [id])
  parentId    String?
  parent      PropertyComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PropertyComment[] @relation("CommentReplies")
  content     String   @db.Text
  likesCount  Int      @default(0)
  isEdited    Boolean  @default(false)
  isPinned    Boolean  @default(false)
  status      String   @default("visible")
  likes       CommentLike[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("property_comments")
}

// ---------- COMMENT LIKES ----------
model CommentLike {
  id         String   @id @default(uuid())
  commentId  String
  comment    PropertyComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

// ---------- PROPERTY LIKES ----------
model PropertyLike {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([propertyId])
  @@index([userId])
  @@map("property_likes")
}

// ---------- USER FOLLOWS ----------
model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

// ---------- USER BLOCKS ----------
model UserBlock {
  id          String   @id @default(uuid())
  blockerId   String
  blocker     User     @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

// ---------- CHAT MESSAGE ACTIONS ----------
model ChatMessageAction {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  action      String   @db.VarChar(20)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@map("chat_message_actions")
}

// ---------- SOS ALERTS ----------
model SOSAlert {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  type       SOSAlertType @default(PANIC)
  status     SOSStatus    @default(ACTIVE)
  location   String?
  latitude   Float?
  longitude  Float?
  message    String?
  resolvedAt DateTime?
  resolvedBy String?
  deletedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("sos_alerts")
}

// ---------- SAFETY REPORTS ----------
model SafetyReport {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  type         SafetyReportType   @default(OTHER)
  status       SafetyReportStatus @default(OPEN)
  title        String
  description  String?
  location     String?
  images       String[]
  assignedToId String?
  resolvedAt   DateTime?
  resolution   String?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("safety_reports")
}

// ---------- COMMUNITIES ----------
model Community {
  id          String    @id @default(uuid())
  name        String
  description String
  city        String
  location    String
  imageUrl    String?
  members     String[]
  createdBy   String
  creator     User      @relation("CommunityCreator", fields: [createdBy], references: [id])
  memberUsers User[]    @relation("CommunityMembers")
  deletedAt   DateTime?

  posts  CommunityPost[]
  events CommunityEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("communities")
}

// ---------- COMMUNITY POSTS ----------
model CommunityPost {
  id             String            @id @default(uuid())
  communityId    String
  community      Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation(fields: [authorId], references: [id])
  content        String
  type           CommunityPostType @default(TEXT)
  mediaUrls      String[]
  pollOptions    String[]
  tags           String[]
  likes          Int               @default(0)
  likedBy        String[]
  comments       Int               @default(0)
  isPinned       Boolean           @default(false)
  isAnnouncement Boolean           @default(false)
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("community_posts")
}

// ---------- COMMUNITY EVENTS ----------
model CommunityEvent {
  id           String    @id @default(uuid())
  communityId  String
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organizerId  String
  organizer    User      @relation("EventOrganizer", fields: [organizerId], references: [id])
  title        String
  description  String?
  eventDate    DateTime
  location     String
  maxAttendees Int?
  imageUrl     String?
  attendees    String[]
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([communityId])
  @@index([organizerId])
  @@index([eventDate])
  @@index([deletedAt])
  @@map("community_events")
}

// ---------- REVIEWS ----------
model Review {
  id         String       @id @default(uuid())
  targetId   String
  targetType String       @db.VarChar(50) // user, property, landlord
  propertyId String?
  property   Property?    @relation("PropertyReviews", fields: [propertyId], references: [id])
  authorId   String
  author     User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  rating     Int
  comment    String?
  images     String[]
  helpful    Int          @default(0)
  status     ReviewStatus @default(PENDING)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetId])
  @@index([targetType])
  @@index([authorId])
  @@index([propertyId])
  @@index([status])
  @@index([deletedAt])
  @@map("reviews")
}

// ---------- MAINTENANCE REQUESTS ----------
model MaintenanceRequest {
  id                 String              @id @default(uuid())
  propertyId         String
  property           Property            @relation("PropertyRequests", fields: [propertyId], references: [id])
  requestedById      String
  requestedBy        User                @relation("RequestedBy", fields: [requestedById], references: [id])
  assignedToId       String?
  assignedTo         User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  title              String
  description        String?
  priority           MaintenancePriority @default(MEDIUM)
  status             MaintenanceStatus   @default(PENDING)
  images             String[]
  notes              String?
  completionNotes    String?
  completionImages   String[]
  completedAt        DateTime?
  cancellationReason String?
  deletedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("maintenance_requests")
}

// ---------- ROOMMATE PROFILES ----------
model RoommateProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation("RoommateUser", fields: [userId], references: [id])
  preferences Json?
  budgetMin   Float?
  budgetMax   Float?
  moveInDate  DateTime?
  duration    String?
  lifestyle   String[]
  bio         String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("roommate_profiles")
}

// ---------- SAVED SEARCHES ----------
model SavedSearch {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id])
  name           String?
  filters        Json?
  alertsEnabled  Boolean   @default(true)
  lastNotifiedAt DateTime?
  deletedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([propertyId])
  @@index([deletedAt])
  @@map("saved_searches")
}

// ---------- SETTINGS ----------
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  userId    String?  @unique
  user      User?    @relation("UserSettings", fields: [userId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("settings")
}

// ---------- SYSTEM THEME ----------
model SystemTheme {
  id           String   @id @default(uuid())
  name         String   @default("Default")
  isActive     Boolean  @default(true)
  colors       Json
  typography   Json?
  borderRadius Json?
  spacing      Json?
  updatedAt    DateTime @updatedAt
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id])

  @@index([isActive])
  @@map("system_themes")
}

// ---------- ANALYTICS ----------
model Analytics {
  id         String  @id @default(uuid())
  eventType  String  @db.VarChar(50)
  entityType String? @db.VarChar(50)
  entityId   String?
  userId     String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  value      Float?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([entityType])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("analytics")
}

// ---------- IDENTITY VERIFICATIONS ----------
model IdentityVerification {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  idType          IdentityType       @default(NATIONAL_ID)
  idNumber        String
  idImage         String?
  selfieImage     String?
  status          VerificationStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?
  notes           String?
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([idType])
  @@index([deletedAt])
  @@map("identity_verifications")
}

// ---------- REFERRALS ----------
model Referral {
  id           String             @id @default(uuid())
  referrerId   String
  referrer     User               @relation("Referrer", fields: [referrerId], references: [id])
  refereeId    String?
  referee      User?              @relation("Referee", fields: [refereeId], references: [id])
  code         String             @unique
  status       ReferralStatus     @default(PENDING)
  rewardType   ReferralRewardType @default(CREDITS)
  rewardAmount Float?
  redeemedAt   DateTime?
  expiresAt    DateTime?
  deletedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@index([refereeId])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@map("referrals")
}

// ---------- FRAUD REPORTS ----------
model FraudReport {
  id           String    @id @default(uuid())
  reportedById String
  entityType   String    @db.VarChar(50)
  entityId     String
  reason       String
  details      String?
  status       String    @default("OPEN") @db.VarChar(50)
  resolvedAt   DateTime?
  resolvedById String?
  deletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportedById])
  @@index([entityType])
  @@index([entityId])
  @@index([status])
  @@index([deletedAt])
  @@map("fraud_reports")
}

// ---------- AUDIT LOGS ----------
model AuditLog {
  id         String  @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- SYSTEM LOGS ----------
model SystemLog {
  id        String  @id @default(uuid())
  level     String  @db.VarChar(20) // INFO, WARNING, ERROR, DEBUG
  message   String
  source    String? // backend, admin, app
  stack     String?
  metadata  Json?
  ipAddress String?
  userId    String?

  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
  @@map("system_logs")
}

// ---------- LEASES ----------
model Lease {
  id            String    @id @default(uuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id])
  tenantId      String
  tenant        User       @relation("TenantLeases", fields: [tenantId], references: [id])
  landlordId    String
  landlord      User       @relation("LandlordLeases", fields: [landlordId], references: [id])
  startDate     DateTime
  endDate       DateTime
  amount        Float
  currency      String     @default("KES")
  status        String     @default("active") @db.VarChar(50) // active, completed, terminated
  depositAmount Float?
  depositStatus String?    @default("pending") @db.VarChar(50) // pending, paid, refunded
  paymentFrequency String @default("monthly") @db.VarChar(50)
  terms         String?
  documentUrl   String?
  signedAt      DateTime?
  terminatedAt  DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
  @@index([deletedAt])
  @@map("leases")
}

// ---------- PAGE VISITS (ANALYTICS) ----------
model PageVisit {
  id            String   @id @default(uuid())
  page          String   @db.VarChar(255)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  ipAddress     String?
  userAgent     String?
  sessionId     String?
  referrer      String?
  duration      Int?
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([page])
  @@index([userId])
  @@index([createdAt])
  @@map("page_visits")
}

// ---------- SUBSCRIPTION MONETIZATION ----------
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  PAUSED
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(100)
  description   String?
  price         Float
  currency      String   @default("KES")
  billingCycle  String   @db.VarChar(20) // monthly, yearly
  maxListings   Int?
  features      String[] @db.Text
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@map("subscription_plans")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  planId        String
  plan          SubscriptionPlan   @relation(fields: [planId], references: [id])
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now())
  endDate       DateTime
  cancelledAt   DateTime?
  paymentMethod String?            @db.VarChar(20) // MPESA, STRIPE, etc.
  paymentProviderId String?
  amount          Float
  currency        String   @default("KES")
  listingsUsed    Int      @default(0)
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

enum MonetizationEventType {
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  PAYMENT_RECEIVED
  SUBSCRIPTION_CANCELLED
  TRIAL_STARTED
}

model SubscriptionEvent {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  eventType     String   @db.VarChar(50)
  amount        Float?
  currency      String?
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@map("subscription_events")
}

// ---------- AD CAMPAIGNS ----------
model AdCampaign {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(255)
  description String?
  imageUrl    String?
  linkUrl     String?
  targetPage  String?
  targetType  String?  @db.VarChar(50) // PROPERTY, EXTERNAL, IN_APP
  targetId    String?
  startDate   DateTime
  endDate     DateTime
  budget      Float
  spent       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  status      String   @default("draft") @db.VarChar(50) // draft, active, paused, completed, cancelled
  priority    Int      @default(0)
  createdBy   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("ad_campaigns")
}

// ---------- USER PROFILE VIDEO ----------
model UserProfileVideo {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  thumbnailUrl String?
  duration    Int      @default(10)
  fileSize    Int?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_profile_videos")
}

// ---------- USER PROFILE MUSIC ----------
model UserProfileMusic {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  artist      String?
  url         String
  duration    Int?
  coverUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_profile_music")
}

// ---------- PRIVACY SETTINGS ----------
model PrivacySettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareEmail             Boolean  @default(false)
  sharePhone             Boolean  @default(true)
  shareLocation          Boolean  @default(true)
  shareOnlineStatus      Boolean  @default(true)
  shareLastSeen          Boolean  @default(true)
  sharePaymentHistory    Boolean  @default(false)
  shareEmployment        Boolean  @default(false)
  shareProfileVideo      Boolean  @default(true)
  shareProfileMusic      Boolean  @default(true)
  allowDirectMessages    Boolean  @default(true)
  allowFollowRequests    Boolean  @default(true)
  showActivityStatus     Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@map("privacy_settings")
}

// ---------- PROPERTY LOCATION FUZZ ----------
model PropertyLocationFuzz {
  id                  String   @id @default(uuid())
  propertyId          String   @unique
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  approximateLat      Float?
  approximateLng      Float?
  exactLat            Float?
  exactLng            Float?
  fuzzRadius          Int      @default(500)
  showExactAfterBooking Boolean @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("property_location_fuzz")
}

// ---------- OFFLINE CACHE ----------
model OfflineCache {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String?
  data       Json
  cachedAt   DateTime @default(now())
  expiresAt  DateTime?
  isSynced   Boolean  @default(true)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([cachedAt])
  @@map("offline_cache")
}

// ---------- DATA EXPORT REQUESTS ----------
model DataExportRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  format      String    @default("json")
  fileUrl     String?
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  @@index([userId])
  @@index([status])
  @@map("data_export_requests")
}

// ---------- DATA DELETE REQUESTS ----------
model DataDeleteRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  reason      String?
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  cancelledAt DateTime?

  @@index([userId])
  @@index([status])
  @@map("data_delete_requests")
}

// ---------- USER PROFILE CARD ----------
model UserProfileCard {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardUrl       String?
  qrCodeUrl     String?
  customMessage String?  @db.Text
  backgroundColor String? @default("#1A5276")
  textColor     String?  @default("#FFFFFF")
  isPublic      Boolean  @default(true)
  scanCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("user_profile_cards")
}

// ---------- NETWORK SPEED LOGS ----------
model NetworkSpeedLog {
  id           String    @id @default(uuid())
  userId       String?
  ipAddress    String?
  downloadSpeed Float?
  uploadSpeed   Float?
  latency       Int?
  connectionType String?
  isLowBandwidth Boolean @default(false)
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("network_speed_logs")
}

// ---------- APP ICON STATES ----------
model AppIconState {
  id        String    @id @default(uuid())
  userId    String?
  state     String
  iconUrl   String
  badgeCount Int      @default(0)
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("app_icon_states")
}

// ---------- LOCATION FUZZ PREFERENCES ----------
model LocationFuzzPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enableFuzzing          Boolean  @default(true)
  fuzzRadius             Int      @default(500)
  showExactAfterViewing  Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@map("location_fuzz_preferences")
}
